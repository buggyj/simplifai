title: $:/plugins/bj/simplifai/widget
type: text/vnd.tiddlywikis
tags: 
stylesheet: $:/themes/bj/cssreset

\widget $mkchat.app()
<$let tid={{{[[$:/temp/bj/simplifai/CurrentGeminiChat]get[text]else[$:/temp/bj/newChat]]}}} test={{{[[test]get[text]]}}}><<runlog "goforit" >>
<$pwidget  class="simplifai" $app="$:/plugins/bj/simplifai/simplifai.mjs"  $tids=`[[:history|$(tid)$]][[model|$(tid)$!!sysmodel]]`  />
</$let>
\end

\widget $mkchat.details(tid) 
<$pwidget  $app="$:/plugins/bj/simplifai/details.mjs"  history={{{[<tid>get[text]]}}} errorMessage="Error in app" />
\end
